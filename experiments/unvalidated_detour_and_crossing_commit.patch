+    def _record_crossing_zone(self, threat, moving_obstacles=()):
+        """Commit distance that carries the whole robot past the mover's lane.
+
+        The old rule (observed near face + 0.25 m along the heading, capped
+        at 1 m) ended commits with the robot's rear still inside the lane --
+        and much more so when crossing a lane at an angle -- where a
+        returning mover then hit it.  Use the lane line through the mover's
+        observed points along its motion, and travel until the robot centre
+        is past that line by the collision radius, the dynamic margin and the
+        observed mover extent, measured perpendicular to the lane.
+        """
+        ox, oy, vx, vy = threat
+        nearby = [
+            point for point in moving_obstacles
+            if math.hypot(point[0] - ox, point[1] - oy) <= 0.4
+        ] or [threat]
+        cx = sum(point[0] for point in nearby) / len(nearby)
+        cy = sum(point[1] for point in nearby) / len(nearby)
+        extent = max(
+            (math.hypot(a[0] - b[0], a[1] - b[1]) for a in nearby for b in nearby),
+            default=0.0,
+        )
+        speed = math.hypot(vx, vy)
+        # A stationary or reversing mover: assume a lane across the heading.
+        ux, uy = (vx / speed, vy / speed) if speed >= DWA_CROSSING_STATIONARY_SPEED else (0.0, 1.0)
+        distance = ox - DWA_CROSSING_CLEARING_X_RANGE[0]
+        if abs(uy) > 0.2:
+            offset = ux * (-cy) + uy * cx  # signed distance of the robot from the lane
+            required = DWA_ROBOT_RADIUS + DWA_DYNAMIC_CLEARANCE_MARGIN + extent
+            distance = max(distance, (abs(offset) + required) / abs(uy))
+        # Keep the longest estimate of this wait episode: once the mover
+        # stops (dwell/reversal) its lane direction is unknown and the
+        # across-the-heading fallback underestimates an angled lane.
+        # _reset_crossing_state() restores the minimum for the next episode.
         self._crossing_exit_distance = max(
-            DWA_CROSSING_COMMIT_MIN_DISTANCE,
+            self._crossing_exit_distance,
             min(DWA_CROSSING_COMMIT_MAX_DISTANCE, distance),
         )
 
@@ -1711,7 +1756,30 @@ class DynamicWindowAvoidance:
         check_obstacles = moving_obstacles if obstacles is None else obstacles
         return self._velocity_is_safe(
             DWA_CROSSING_COMMIT_SPEED, 0.0, check_obstacles
-        )
