@@ -303,6 +303,30 @@ class TestStoppedMover(unittest.TestCase):
         self.assertIsNone(released)  # bounded wait
         self.assertFalse(planner.crossing_waiting)
 
+    def test_commit_requires_the_whole_line_to_clear_a_dwelling_mover(self):
+        planner = DynamicWindowAvoidance()
+        planner._crossing_exit_distance = 0.8
+        beside_later = [(0.60, 0.26, 0.0, 0.0)]  # stopped mover beside the line
+        self.assertFalse(planner._commit_path_is_clear(beside_later))
+        far = [(0.60, 0.60, 0.0, 0.0)]
+        self.assertTrue(planner._commit_path_is_clear(far))
+
+    def test_commit_carries_the_robot_past_an_angled_lane(self):
+        planner = DynamicWindowAvoidance()
+        perpendicular = (0.50, 0.30, 0.0, -0.30)
+        planner._record_crossing_zone(perpendicular, [perpendicular])
+        straight = planner._crossing_exit_distance
+        planner._reset_crossing_state()
+        # Same lane crossed at ~60 degrees: the band is longer along the heading.
+        angled = (0.50, 0.30, 0.15, -0.26)
+        planner._record_crossing_zone(angled, [angled])
+        self.assertGreater(planner._crossing_exit_distance, straight)
+        self.assertGreaterEqual(straight, 0.50 + 0.17 + 0.15)
+        # A later stationary observation must not shorten the estimate.
+        longest = planner._crossing_exit_distance
+        planner._record_crossing_zone((0.50, 0.30, 0.0, 0.0), [(0.50, 0.30, 0.0, 0.0)])
+        self.assertEqual(longest, planner._crossing_exit_distance)
+
     def test_path_follower_is_not_released_during_a_crossing_wait(self):
