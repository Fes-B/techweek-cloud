+    def _commit_path_is_clear(self, obstacles):
+        """The whole committed straight line must keep both margins now.
+
+        The commit is checked frame by frame by the common 1.2 s safety gate
+        (about 0.26 m at commit speed).  Accepting a gap on that short check
+        let a commit start while a mover dwelling beside the later part of
+        the line was inside the dynamic margin; the gate then stopped the
+        robot half inside the crossing lane.  Accept only when every point
+        of the committed distance clears each tracked mover by the dynamic
+        margin and each static point by the static margin.
+        """
+        length = self._crossing_exit_distance
+        dynamic_limit = DWA_ROBOT_RADIUS + DWA_DYNAMIC_CLEARANCE_MARGIN
+        static_limit = DWA_ROBOT_RADIUS + DWA_STATIC_CLEARANCE_MARGIN
+        for point in obstacles:
+            x, y = point[0], point[1]
+            along = max(0.0, min(length, x))
+            distance = math.hypot(x - along, y)
+            limit = dynamic_limit if len(point) == 4 else static_limit
+            if distance <= limit:
+                return False
+        return True
 
