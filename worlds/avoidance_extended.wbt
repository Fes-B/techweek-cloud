  translation -1.20 -6.825 0.25
  name "slalom obstacle 1"
  children [ Shape { appearance PBRAppearance { baseColor 0.80 0.55 0.10 } geometry Box { size 0.45 0.45 0.50 } } ]
  boundingObject Box { size 0.45 0.45 0.50 }
}
Solid {
  translation 2.30 -6.175 0.25
  name "slalom obstacle 2"
  children [ Shape { appearance PBRAppearance { baseColor 0.80 0.55 0.10 } geometry Box { size 0.45 0.45 0.50 } } ]
  boundingObject Box { size 0.45 0.45 0.50 }
}
Solid {
  translation 5.80 -6.825 0.25
  name "slalom obstacle 3"
  children [ Shape { appearance PBRAppearance { baseColor 0.80 0.55 0.10 } geometry Box { size 0.45 0.45 0.50 } } ]
  boundingObject Box { size 0.45 0.45 0.50 }
}

