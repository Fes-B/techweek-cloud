# --- Scenario 8/10: Dynamic A (south->north) and Dynamic B (north->south), y=1.60 baseline. ---
Robot {
  translation 2.50 0.20 0.18
  name "dynamic actor A"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.10 0.70 0.30 roughness 0.6 }
      geometry Box { size 0.28 0.28 0.36 }
    }
  ]
  boundingObject Box { size 0.28 0.28 0.36 }
  controller "extended_crossing_controller"
  customData "axis=y min=0.20 max=3.00 speed=0.30 dwell=3.5 start=min trigger_axis=x trigger=3.40 trigger_dir=le gate_axis=y gate_min=1.00 gate_max=2.20 robot=EXTENDED_ROBOT"
  supervisor TRUE
}
Robot {
  translation -2.50 3.00 0.18
  name "dynamic actor B"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.70 0.30 0.70 roughness 0.6 }
      geometry Box { size 0.28 0.28 0.36 }
    }
  ]
  boundingObject Box { size 0.28 0.28 0.36 }
  controller "extended_crossing_controller"
  customData "axis=y min=0.20 max=3.00 speed=0.30 dwell=3.5 start=max trigger_axis=x trigger=-1.80 trigger_dir=le gate_axis=y gate_min=1.00 gate_max=2.20 robot=EXTENDED_ROBOT"
  supervisor TRUE
}

